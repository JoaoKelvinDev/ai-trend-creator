# AI Trend Creator - Variáveis de Ambiente
# Copie para .env e preencha os valores necessários
# NUNCA commite o arquivo .env real

# ──────────────────────────────────────────────
# Aplicação
# ──────────────────────────────────────────────
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
APP_HOST=127.0.0.1
APP_PORT=8000

# Controles de segurança e custo (R$ 0 obrigatório)
APP_AUTO_PUBLISH=false
APP_CANDIDATE_LIMIT_PER_DAY=2
APP_MAX_REGENERATIONS_PER_CANDIDATE=2
APP_ALLOW_PAID_PROVIDERS=false
APP_EXTERNAL_BILLING_ENABLED=false
APP_TIKTOK_DIRECT_POST_ENABLED=false
APP_LOCAL_VIDEO_DIFFUSION_ENABLED=false

# ──────────────────────────────────────────────
# Banco de Dados e Filas
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/ai_trend_creator
REDIS_URL=redis://127.0.0.1:6379/0
LOCAL_STORAGE_ROOT=./data

# ──────────────────────────────────────────────
# Provedores de IA (Locais - Custo Zero)
# ──────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

IMAGE_PROVIDER=comfyui_or_template
COMFYUI_URL=http://127.0.0.1:8188

SPEECH_PROVIDER=piper_local
PIPER_VOICE=pt_BR-faber-medium
PIPER_BINARY_PATH=./bin/piper

# ──────────────────────────────────────────────
# Descoberta de Tendências
# ──────────────────────────────────────────────
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=

RSS_ENABLED=true
# Lista de URLs RSS separadas por vírgula
RSS_ALLOWED_FEEDS=

# Importação manual (JSON/CSV) - sempre habilitada
MANUAL_IMPORT_ENABLED=true

# ──────────────────────────────────────────────
# Telegram Bot (Aprovação)
# ──────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# User IDs numéricos permitidos, separados por vírgula
TELEGRAM_ALLOWED_USER_IDS=
# Chat IDs permitidos, separados por vírgula
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_WEBHOOK_URL=

# ──────────────────────────────────────────────
# TikTok Publicação
# ──────────────────────────────────────────────
TIKTOK_PUBLISH_MODE=assisted
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/tiktok/callback

# ──────────────────────────────────────────────
# Observabilidade
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=false